<Window x:Class="OllaMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OllaMonitor"
        mc:Ignorable="d"
        Title="OllaMonitor" 
        Height="300" 
        Width="350"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Modern Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#44FFFFFF" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseDown="Window_MouseDown" Margin="10">
        <!-- Main Window Shadow and Glass Border -->
        <Border CornerRadius="12" 
                Background="#E61A1A1E" 
                BorderBrush="#40FFFFFF" 
                BorderThickness="1">
            <Border.ContextMenu>
                <ContextMenu x:Name="MainContextMenu" Background="#1C1C1E" Foreground="White" BorderBrush="#30FFFFFF">
                    <MenuItem Header="Always on Top" x:Name="ContextAlwaysOnTop" IsCheckable="True" Click="ContextAlwaysOnTop_Click"/>
                    <MenuItem Header="Manual Refresh" Click="ContextRefresh_Click"/>
                    <Separator Background="#30FFFFFF"/>
                    <MenuItem Header="Exit" Click="ContextExit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Color="Black" Opacity="0.5"/>
            </Border.Effect>
            
            <Grid ClipToBounds="True">
                <!-- Main Grid Layout -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>  <!-- Header -->
                    <RowDefinition Height="110"/> <!-- Cards -->
                    <RowDefinition Height="Auto"/> <!-- Details Header -->
                    <RowDefinition Height="*"/>    <!-- Unified ListBox -->
                    <RowDefinition Height="30"/>   <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0" Background="#15FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Ellipse x:Name="OllamaStatusIndicator" Width="8" Height="8" Fill="#FF8E8E93" Margin="0,1,8,0"/>
                        <TextBlock Text="OllaMonitor" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GpuModelLabel" Text="" Foreground="#80FFFFFF" FontSize="10" Margin="10,2,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Pin/Always on Top Button -->
                        <Button x:Name="PinButton" Click="PinButton_Click" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Path x:Name="PinPath" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.8,4H15.2V12H8.8V4M10,14H14L15,15H9L10,14Z" 
                                              Fill="#80FFFFFF" Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PinPath" Property="Fill" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- Minimize Button -->
                        <Button Click="MinimizeButton_Click" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Path x:Name="MinPath" Data="M20 19H4v-2h16v2z" Fill="#80FFFFFF" Width="12" Height="12" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MinPath" Property="Fill" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Path x:Name="ClosePath" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z" Fill="#80FFFFFF" Width="12" Height="12" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ClosePath" Property="Fill" Value="#FF453A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Core Dashboard Area (Fixed Row 1) -->
                <Grid Grid.Row="1" Margin="10,6,5,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU Card -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#0CFFFFFF" CornerRadius="8" Margin="0,0,5,6" Padding="8,5">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CPU" Foreground="#80FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CpuText" Text="0.0%" Foreground="#FF0A84FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="CpuProgress" Height="3" Margin="0,4,0,4" Background="#20FFFFFF" Foreground="#FF0A84FF" BorderThickness="0" MaxHeight="3"/>
                            <Canvas x:Name="CpuCanvas" Height="15" Background="#05FFFFFF" ClipToBounds="True">
                                <Polyline x:Name="CpuPolyline" Stroke="#FF0A84FF" StrokeThickness="1"/>
                            </Canvas>
                        </StackPanel>
                    </Border>

                    <!-- RAM Card -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#0CFFFFFF" CornerRadius="8" Margin="5,0,0,6" Padding="8,5">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="RAM" Foreground="#80FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RamText" Text="0.0%" Foreground="#FFBF00FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="RamProgress" Height="3" Margin="0,4,0,4" Background="#20FFFFFF" Foreground="#FFBF00FF" BorderThickness="0" MaxHeight="3"/>
                            <Canvas x:Name="RamCanvas" Height="15" Background="#05FFFFFF" ClipToBounds="True">
                                <Polyline x:Name="RamPolyline" Stroke="#FFBF00FF" StrokeThickness="1"/>
                            </Canvas>
                        </StackPanel>
                    </Border>

                    <!-- GPU Card -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#0CFFFFFF" CornerRadius="8" Margin="0,0,5,0" Padding="8,5">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="GPU" Foreground="#80FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GpuText" Text="0%" Foreground="#FF30D5C8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="GpuProgress" Height="3" Margin="0,4,0,4" Background="#20FFFFFF" Foreground="#FF30D5C8" BorderThickness="0" MaxHeight="3"/>
                            <Canvas x:Name="GpuCanvas" Height="15" Background="#05FFFFFF" ClipToBounds="True">
                                <Polyline x:Name="GpuPolyline" Stroke="#FF30D5C8" StrokeThickness="1"/>
                            </Canvas>
                        </StackPanel>
                    </Border>

                    <!-- VRAM Card -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#0CFFFFFF" CornerRadius="8" Margin="5,0,0,0" Padding="8,5">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="VRAM" Foreground="#80FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="VramText" Text="0.0 GB" Foreground="#FFFF9F0A" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="VramProgress" Height="3" Margin="0,4,0,4" Background="#20FFFFFF" Foreground="#FFFF9F0A" BorderThickness="0" MaxHeight="3"/>
                            <Canvas x:Name="VramCanvas" Height="15" Background="#05FFFFFF" ClipToBounds="True">
                                <Polyline x:Name="VramPolyline" Stroke="#FFFF9F0A" StrokeThickness="1"/>
                            </Canvas>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Details Switch Header (Row 2) -->
                <Button x:Name="DetailsHeaderButton" Grid.Row="2" Click="DetailsHeaderButton_Click" Background="#10FFFFFF" BorderThickness="0" Margin="10,5,10,3" Padding="8,4" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <Grid HorizontalAlignment="Stretch">
                        <TextBlock x:Name="DetailsHeaderText" Text="SYSTEM DETAILS ⇅" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                    </Grid>
                </Button>

                <!-- Consolidated details ListBox (Row 3) -->
                <ListBox x:Name="DetailsListBox" Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="10,0,10,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- Bypass default Windows ListBox item hover highlights -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Footer Bar -->
                <Grid Grid.Row="4" Background="#0AFFFFFF">
                    <TextBlock x:Name="StatusFooterText" Text="System monitoring active" Foreground="#60FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Click="GearButton_Click" Background="Transparent" BorderThickness="0" Width="30" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <Path x:Name="GearPath" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#80FFFFFF" Width="14" Height="14" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GearPath" Property="Fill" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Expandable Settings Sliding Panel -->
                <Grid x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="5" Background="#F018181A" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <Grid Grid.Row="0" Background="#10FFFFFF">
                        <TextBlock Text="Settings" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        <Button Click="SettingsCloseButton_Click" Background="Transparent" BorderThickness="0" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Path x:Name="BackPath" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z" Fill="#80FFFFFF" Width="12" Height="12" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BackPath" Property="Fill" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Settings Controls -->
                    <StackPanel Grid.Row="1" Margin="20">
                        <!-- Ollama URL setting -->
                        <TextBlock Text="OLLAMA API URL" Foreground="#80FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="OllamaUrlInput" Background="#15FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="6" FontSize="11" Margin="0,0,0,15">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Refresh Interval setting -->
                        <TextBlock Text="REFRESH INTERVAL (SECONDS)" Foreground="#80FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RefreshRateSlider" Minimum="1" Maximum="10" Value="2" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="RefreshRateLabel" Text="{Binding ElementName=RefreshRateSlider, Path=Value, StringFormat={}{0:F0}s}" Foreground="White" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Always on Top setting -->
                        <Grid Margin="0,0,0,25">
                            <TextBlock Text="ALWAYS ON TOP" Foreground="#80FFFFFF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AlwaysOnTopCheckbox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Button Click="SaveSettingsButton_Click" Content="Save &amp; Apply" Background="#FF0A84FF" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="10" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF0A84FF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
